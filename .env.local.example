# ---------------------------------------------------------------------------
# Environment variables for Vercel (Project Settings -> Environment Variables)
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Also powers the free-demo rate limiter (demo_usage table).
SUPABASE_SERVICE_ROLE_KEY=

# --- Guest access ------------------------------------------------------------
# One-click anonymous sign-in ("Try the demo as a guest"). Also enable
# Authentication -> Sign In / Providers -> "Allow anonymous sign-ins" in Supabase.
# Guests bypass EMAIL_*_WHITELIST; set to false to turn guest access off.
GUEST_ACCESS_ENABLED=true

# --- Free demo tier (server keys) ---------------------------------------------
# Visitors WITHOUT their own key in Profile Settings chat on these keys, on a
# cheap model, limited to DEMO_DAILY_LIMIT messages per IP and per account per
# UTC day. Users who save their own key are unlimited and never touch these.
# Set at least one of the two keys; leave both empty to require BYOK.
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Optional, server-only OpenAI organization for the demo key
OPENAI_ORGANIZATION_ID=

# Optional tuning (defaults shown)
DEMO_ENABLED=true
DEMO_DAILY_LIMIT=5
DEMO_OPENAI_MODEL=gpt-4o-mini
DEMO_GOOGLE_MODEL=gemini-3.5-flash-lite
# Optional salt for hashing visitor IPs (defaults to the service role key)
DEMO_IP_SALT=

# NOTE: Anthropic, Mistral, Groq, Perplexity, OpenRouter and Azure are
# bring-your-own-key only. Server keys for them are intentionally not used.

# --- Optional ---------------------------------------------------------------
# Restrict sign-ups (comma-separated)
EMAIL_DOMAIN_WHITELIST=
EMAIL_WHITELIST=

# Upload limit in bytes
NEXT_PUBLIC_USER_FILE_SIZE_LIMIT=10485760

# Local models only (not reachable from Vercel)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
